generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  password           String
  plan               String       @default("free")
  verified           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tokens             Int          @default(5)
  monthlyTokens      Int          @default(5)
  lastTokenRefill    DateTime     @default(now())
  aiModel            String       @default("")
  aiProvider         String       @default("")
  apiKeyEncrypted    String?      @default("")
  lastLoginAt        DateTime?
  loginCount         Int          @default(0)
  onboardingComplete Boolean      @default(false)
  apiKeys            ApiKey[]
  ideas              Idea[]
  teams              TeamMember[]
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  description    String
  targetAudience String   @default("")
  industry       String   @default("")
  attachments    String   @default("")
  status         String   @default("pending")
  marketScope    String   @default("global")
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isPublic       Boolean  @default(false)
  publicSlug     String?  @unique
  shareCount     Int      @default(0)
  viewCount      Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report         Report?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        String   @id @default(cuid())
  email     String
  company   String
  teamSize  String   @default("")
  message   String   @default("")
  createdAt DateTime @default(now())
}

model Report {
  id                   String   @id @default(cuid())
  viabilityScore       Float
  marketScore          Float
  competitorScore      Float
  monetizationScore    Float
  riskScore            Float
  marketAnalysis       String
  competitorOverview   String
  monetizationModels   String
  riskAssessment       String
  nextSteps            String
  sources              String   @default("[]")
  valueHypothesis      String   @default("")
  riskiestAssumption   String   @default("")
  pivotSuggestions     String   @default("[]")
  usedFallback         Boolean  @default(false)
  problemSeverity      Float    @default(5)
  marketUrgency        Float    @default(5)
  easeOfReplica        Float    @default(5)
  founderIdeaFit       Float    @default(5)
  executionComplexity  Float    @default(5)
  nineDimensions       String   @default("[]")
  gtmExperiments       String   @default("{}")
  skepticAnalysis      String   @default("{}")
  marketSizing         String   @default("{}")
  actionPlan           String   @default("[]")
  swotAnalysis         String   @default("{}")
  competitiveLandscape String   @default("{}")
  marketTiming         String   @default("{}")
  createdAt            DateTime @default(now())
  ideaId               String   @unique
  adversarialVerdict   String   @default("")
  confidence           Float    @default(70)
  idea                 Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Team {
  id        String       @id @default(cuid())
  name      String
  plan      String       @default("enterprise")
  createdAt DateTime     @default(now())
  members   TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  role      String   @default("member")
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  keyPreview String
  userId     String
  name       String    @default("API Key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
}

model ValidationBenchmark {
  id               String   @id @default(cuid())
  industry         String
  avgViability     Float
  avgMarket        Float
  avgRisk          Float
  totalValidations Int
  updatedAt        DateTime @default(now())
}
