generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  plan            String   @default("free")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tokens          Int      @default(5)
  monthlyTokens   Int      @default(5)
  lastTokenRefill  DateTime @default(now())
  ideas           Idea[]
  teams           TeamMember[]
  onboardingComplete Boolean @default(false)
  lastLoginAt     DateTime?
  loginCount      Int      @default(0)
  apiKeyEncrypted String?  @default("")
  aiProvider      String   @default("")
  aiModel         String   @default("")
  apiKeys         ApiKey[]
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  description    String
  targetAudience String   @default("")
  industry       String   @default("")
  attachments    String   @default("")
  status         String   @default("pending")
  marketScope    String   @default("global")
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report         Report?
  isPublic       Boolean  @default(false)
  publicSlug     String?  @unique
  viewCount      Int      @default(0)
  shareCount     Int      @default(0)
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        String   @id @default(cuid())
  email     String
  company   String
  teamSize  String   @default("")
  message   String   @default("")
  createdAt DateTime @default(now())
}

model Report {
  id                  String   @id @default(cuid())
  viabilityScore      Float
  marketScore         Float
  competitorScore     Float
  monetizationScore   Float
  riskScore           Float
  marketAnalysis      String
  competitorOverview  String
  monetizationModels  String
  riskAssessment      String
  nextSteps           String
  sources             String   @default("[]")
  valueHypothesis     String   @default("")
  riskiestAssumption  String   @default("")
  pivotSuggestions    String   @default("[]")
  usedFallback        Boolean  @default(false)
  problemSeverity     Float    @default(5)
  marketUrgency       Float    @default(5)
  easeOfReplica       Float    @default(5)
  founderIdeaFit      Float    @default(5)
  executionComplexity Float    @default(5)
  nineDimensions      String   @default("[]")
  gtmExperiments      String   @default("{}")
  skepticAnalysis     String   @default("{}")
  marketSizing        String   @default("{}")
  actionPlan          String   @default("[]")
  swotAnalysis        String   @default("{}")
  competitiveLandscape String  @default("{}")
  marketTiming        String   @default("{}")
  createdAt          DateTime @default(now())
  ideaId             String   @unique
  idea               Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  confidence         Float    @default(70)
  adversarialVerdict String   @default("")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("enterprise")
  createdAt DateTime @default(now())
  members   TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  role      String   @default("member")
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([userId, teamId])
}

model ApiKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique
  keyPreview  String
  userId      String
  name        String    @default("API Key")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revoked     Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([keyHash])
  @@index([userId])
}

model ValidationBenchmark {
  id             String   @id @default(cuid())
  industry       String
  avgViability   Float
  avgMarket      Float
  avgRisk        Float
  totalValidations Int
  updatedAt      DateTime @default(now())
}
